    <child link="base_link"/>
  </joint>
  <!-- joints - main serial chain -->
  <joint name="base_link-base_link_inertia" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_inertia"/>
    <!-- 'base_link' is REP-103 aligned (so X+ forward), while the internal
           frames of the robot/controller have X+ pointing backwards.
           Use the joint between 'base_link' and 'base_link_inertia' (a dummy
           link/frame) to introduce the necessary rotation over Z (of pi rad).
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link_inertia"/>
    <child link="shoulder_link"/>
    <origin rpy="0 0 3.799500009500555e-07" xyz="0 0 0.18094755993188189"/>
    <axis xyz="0 0 1"/>
    <limit effort="330.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0943951023931953"/>
    <safety_controller k_position="20" k_velocity="0.0" soft_lower_limit="-6.133185307179586" soft_upper_limit="6.133185307179586"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin rpy="1.5707077521418438 0 1.869313694303335e-06" xyz="4.1641356476411076e-05 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="330.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0943951023931953"/>
    <safety_controller k_position="20" k_velocity="0.0" soft_lower_limit="-6.133185307179586" soft_upper_limit="6.133185307179586"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin rpy="3.1412265757718756 3.1398784597649074 -3.1415921089762904" xyz="-0.6125056975415517 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
    <safety_controller k_position="20" k_velocity="0.0" soft_lower_limit="-2.991592653589793" soft_upper_limit="2.991592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin rpy="0.004294137489950946 -0.0018611152908462512 8.224790818824811e-06" xyz="-0.5715869617435085 -0.0007466747953528752 0.17388129924318446"/>
    <axis xyz="0 0 1"/>
    <limit effort="54.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <safety_controller k_position="20" k_velocity="0.0" soft_lower_limit="-6.133185307179586" soft_upper_limit="6.133185307179586"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin rpy="1.5704706412651575 0 -7.429584076984463e-07" xyz="-5.72263707324922e-05 -0.11974370002564419 3.8998791754660974e-05"/>
    <axis xyz="0 0 1"/>
    <limit effort="54.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <safety_controller k_position="20" k_velocity="0.0" soft_lower_limit="-6.133185307179586" soft_upper_limit="6.133185307179586"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin rpy="1.5715521534390913 3.141592653589793 3.141592616055372" xyz="-7.838866223577258e-05 0.1153830495241173 8.720959972563012e-05"/>
    <axis xyz="0 0 1"/>
    <limit effort="54.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <safety_controller k_position="20" k_velocity="0.0" soft_lower_limit="-6.133185307179586" soft_upper_limit="6.133185307179586"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <link name="ft_frame"/>
  <joint name="wrist_3_link-ft_frame" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="ft_frame"/>
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'base' frame - base_link to UR 'Base' Coordinates transform -->
  <link name="base"/>
  <joint name="base_link-base_fixed_joint" type="fixed">
    <!-- Note the rotation over Z of pi radians - as base_link is REP-103
           aligned (i.e., has X+ forward, Y+ left and Z+ up), this is needed
           to correctly align 'base' with the 'Base' coordinate system of
           the UR controller.
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="base"/>
  </joint>
  <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
  <link name="flange"/>
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="flange"/>
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
  <link name="tool0"/>
  <joint name="flange-tool0" type="fixed">
    <!-- default toolframe - X+ left, Y+ up, Z+ front -->
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="flange"/>
    <child link="tool0"/>
  </joint>
  <!-- Adapter fixed directly to the UR tool frame.  The mesh is in millimetres. -->
  <link name="zivid_mount_link">
    <visual>
      <geometry>
        <mesh filename="package://bae_description/meshes/Universal_mount.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="bae_mount_white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://bae_description/meshes/Universal_mount.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="zivid_mount_joint" type="fixed">
    <parent link="tool0"/>
    <child link="zivid_mount_link"/>
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>
  <!-- Zivid base link -->
  <link name="zivid_base_link">
    <!-- Visuals -->
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://zivid_description/meshes/visual/zivid_2_plus.stl"/>
      </geometry>
      <material name="zivid_gray"/>
    </visual>
    <!-- Collisions -->
    <collision>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://zivid_description/meshes/collision/zivid_2_plus_convex_hull.stl"/>
      </geometry>
    </collision>
  </link>
  <!-- Zivid optical frame (measurement frame)-->
  <link name="zivid_optical_frame"/>
  <!-- Zivid optical (measurement) joint. This joint is based on uncalibrated values from the specifications,
        expect some real-world differences. Hand-eye calibration should be performed for accurate placement of the point
        cloud in a target coordinate frame.  -->
  <joint name="zivid_uncalibrated_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.6231562043547265" xyz="0.04802 0.03084 0.0295"/>
    <parent link="zivid_base_link"/>
    <child link="zivid_optical_frame"/>
  </joint>
  <!-- Hand-eye-calibrated 2026-09-23 from five UR12e poses. The solver
       returned tool0 -> zivid_optical_frame in millimetres; converted here
       through the fixed tool0 -> mount and vendor base -> optical transforms
       into this mount -> zivid_base_link joint. Previous nominal CAD values
       were xyz="0.025 0.050 0.0325" rpy="0 -1.5708 -1.5708". -->
  <joint name="zivid_joint" type="fixed">
    <parent link="zivid_mount_link"/>
    <child link="zivid_base_link"/>
    <origin rpy="0.624611423220 -1.563017554838 -2.200273075584" xyz="0.025614903897 0.052700614419 0.035858894524"/>
  </joint>
  <link name="fake_probe_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.088135"/>
      <geometry>
        <box size="0.020 0.025 0.17627"/>
      </geometry>
      <material name="fake_probe_blue">
        <color rgba="0.1 0.35 0.9 0.85"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.088135"/>
      <geometry>
        <box size="0.020 0.025 0.17627"/>
      </geometry>
    </collision>
  </link>
  <joint name="fake_probe_joint" type="fixed">
    <parent link="zivid_mount_link"/>
    <child link="fake_probe_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="sensor_tip"/>
  <joint name="sensor_tip_joint" type="fixed">
    <parent link="fake_probe_link"/>
    <child link="sensor_tip"/>
    <origin rpy="0 0 0" xyz="0 0 0.17627"/>
  </joint>
</robot>

